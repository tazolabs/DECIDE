{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "site",
  "cleanUrls": true,
  "regions": ["iad1"],
  "functions": {
    "api/evaluations.mjs": { "maxDuration": 60 },
    "api/consume.mjs": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "site/preview/**",
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "decide-evaluations" }]
    }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'" }
    ]}
  ]
}
